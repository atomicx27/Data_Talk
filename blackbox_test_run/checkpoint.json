            {
              "cust_tier": "Enterprise",
              "total_gross_revenue_usd": 1264040.0,
              "total_refund_usd": 88152.4,
              "net_retained_revenue_usd": 1175887.6,
              "return_rate_pct": 6.97
            }
          ],
          "executed_query": "WITH orders_cte AS (\n    SELECT o.customer_id,\n           SUM(o.gross_revenue_usd) AS gross_revenue_usd,\n           COUNT(DISTINCT o.order_id) AS total_orders\n    FROM fact_orders o\n    WHERE o.ord_stat <> 'Cancelled'\n    GROUP BY o.customer_id\n),\nreturns_cte AS (\n    SELECT r.customer_id,\n           SUM(r.refund_amount_usd) AS refund_usd,\n           COUNT(DISTINCT r.return_id) AS total_returns\n    FROM fact_returns r\n    GROUP BY r.customer_id\n)\nSELECT c.cust_tier,\n       ROUND(SUM(COALESCE(o.gross_revenue_usd, 0)), 2) AS total_gross_revenue_usd,\n       ROUND(SUM(COALESCE(r.refund_usd, 0)), 2) AS total_refund_usd,\n       ROUND(SUM(COALESCE(o.gross_revenue_usd, 0)) - SUM(COALESCE(r.refund_usd, 0)), 2) AS net_retained_revenue_usd,\n       ROUND(100.0 * SUM(COALESCE(r.refund_usd, 0)) / NULLIF(SUM(COALESCE(o.gross_revenue_usd, 0)), 0), 2) AS return_rate_pct\nFROM dim_customers c\nLEFT JOIN orders_cte o ON c.customer_id = o.customer_id\nLEFT JOIN returns_cte r ON c.customer_id = r.customer_id\nGROUP BY c.cust_tier\nORDER BY total_gross_revenue_usd DESC;"
        },
