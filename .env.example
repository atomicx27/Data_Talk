# ============================================================================
# Data_Talk Enterprise BI — Environment Configuration Template
# Copy this file to `.env` and fill in your provider API keys.
# ============================================================================

# Primary LLM Provider (Groq Cloud)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Secondary Automatic Failover LLM Provider (NVIDIA NIM)
NVIDIA_NIM_API_KEY=nvapi-your_nvidia_nim_key_here

# Active Default Model & Failover Model
DATATALK_DEFAULT_MODEL=groq/openai/gpt-oss-120b
DATATALK_FAILOVER_MODEL=nvidia_nim/nvidia/nemotron-3.5-lightning-30b-a3b

# Optional Additional Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
