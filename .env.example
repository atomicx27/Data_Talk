# ============================================================================
# Data_Talk Enterprise BI — Environment Configuration Template
# Copy this file to `.env` and fill in your provider API keys and settings.
# ============================================================================

# Primary LLM Provider (Groq Cloud)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Secondary Automatic Failover LLM Provider (NVIDIA NIM)
NVIDIA_NIM_API_KEY=nvapi-your_nvidia_nim_key_here

# Active Default Model & Failover Model
DATATALK_DEFAULT_MODEL=groq/openai/gpt-oss-120b
DATATALK_FAILOVER_MODEL=nvidia_nim/nvidia/nemotron-3.5-lightning-30b-a3b

# Optional Additional Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ----------------------------------------------------------------------------
# Security & Deployment Configuration
# ----------------------------------------------------------------------------

# Optional: Master encryption key for the local credential vault (.secrets/vault.enc)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_TALK_MASTER_KEY=

# Optional: Require Bearer token authentication for all /api/* endpoints
# When set, browser users are prompted for this token once to obtain a secure dt_session cookie.
DATA_TALK_API_TOKEN=

# Allowed Origins for CORS & Cross-Site Mutation Defense (comma-separated)
DATA_TALK_ALLOWED_ORIGINS=http://127.0.0.1:8504,http://localhost:8504,http://127.0.0.1:8000,http://localhost:8000

# Maximum file upload limit in megabytes (CSV, Excel, Parquet, PBIX)
MAX_UPLOAD_MB=200

# Server Binding
HOST=127.0.0.1
PORT=8504
